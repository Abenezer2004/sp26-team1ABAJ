spring.application.name=backendAPI
server.port=8080

# Copy this file to application.properties and add your local Neon connection string.
# DO NOT COMMIT your real password.
spring.datasource.url=jdbc:postgresql://YOUR_NEON_HOST/YOUR_DB?sslmode=require
spring.datasource.username=YOUR_USERNAME
spring.datasource.password=YOUR_PASSWORD

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
