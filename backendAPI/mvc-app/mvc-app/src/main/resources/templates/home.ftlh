<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nurse Search</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <nav class="navbar">
        <div class="container navbar-content">
            <div class="logo">Nurse Search</div>
            <ul class="nav-links">
                <li><a href="/" class="active">Home</a></li>
                <li><a href="/customer/search">Find Nurses</a></li>
                <li><a href="/customer/login">Customer Log In</a></li>
                <li><a href="/provider/login">Nurse Log In</a></li>
                <li><a href="/customer/signup" class="btn btn-primary btn-small">Customer Sign Up</a></li>
                <li><a href="/provider/signup" class="btn btn-secondary btn-small">Register as Nurse</a></li>
            </ul>
        </div>
    </nav>

    <div class="container">
        <section class="hero">
            <h1>Find Quality Home Care</h1>
            <p>Connect with qualified nurses who speak your language</p>
            <div class="hero-cta">
                <a href="/customer/search" class="btn btn-primary btn-large">Find a Nurse</a>
                <a href="/customer/signup" class="btn btn-secondary btn-large">Create Customer Account</a>
                <a href="/provider/signup" class="btn btn-secondary btn-large">Register as Nurse</a>
            </div>
        </section>

        <section class="section">
            <h2 class="section-title">Why Choose Nurse Search?</h2>
            <div class="grid grid-3">
                <div class="card feature-card">
                    <div class="feature-icon">Search</div>
                    <h3>Easy Search</h3>
                    <p>Filter by specialty, language, experience, and price.</p>
                </div>
                <div class="card feature-card">
                    <div class="feature-icon">Verified Nurses</div>
                    <h3>Verified Nurses</h3>
                    <p>All nurses are qualified professionals.</p>
                </div>
                <div class="card feature-card">
                    <div class="feature-icon">Support</div>
                    <h3>Language Support</h3>
                    <p>Find nurses who speak your preferred language for comfortable, accessible care.</p>
                </div>
            </div>
        </section>

        <section class="section">
            <h2 class="section-title">How It Works</h2>
            <div class="grid grid-2">
                <div class="card">
                    <div class="step-card">
                        <div class="step-number">1</div>
                        <div class="step-content">
                            <h4>Create Your Profile</h4>
                            <p>Sign up as a customer or register as a nurse provider.</p>
                        </div>
                    </div>
                </div>
                <div class="card">
                    <div class="step-card">
                        <div class="step-number">2</div>
                        <div class="step-content">
                            <h4>Post or Browse Listings</h4>
                            <p>Customers describe their care needs, and nurses browse open listings.</p>
                        </div>
                    </div>
                </div>
                <div class="card">
                    <div class="step-card">
                        <div class="step-number">3</div>
                        <div class="step-content">
                            <h4>Get Matched</h4>
                            <p>Customers can book nurses, and nurses can manage appointment requests.</p>
                        </div>
                    </div>
                </div>
                <div class="card">
                    <div class="step-card">
                        <div class="step-number">4</div>
                        <div class="step-content">
                            <h4>Get Quality Care</h4>
                            <p>Receive or provide professional care at home.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="card cta-section">
            <h2>Ready to Find or Provide Quality Care?</h2>
            <div class="hero-cta">
                <a href="/customer/signup" class="btn btn-primary btn-large">Get Started as Customer</a>
                <a href="/provider/signup" class="btn btn-secondary btn-large">Register as Nurse</a>
            </div>
        </section>
    </div>

</body>
</html>